+    /// S6a「逆转紧迫度」特征（version 5 追加，2026-10-17）：6 行常量通道，全部由
+    /// `state.scores`（已旋转为相对序，`scores[0]` = 自家）确定性导出，无任何分布假设。
+    ///
+    /// - 行 0..4：与排序后第 1/2/3/4 名的点差 `d_k = me − all[k]`（四家分数降序）。
+    ///   `d_1 ≤ 0 ≤ d_4`，且 `d_k = 0` 的位置即自家当前顺位——符号模式本身就是顺位。
+    /// - 行 4：`overtake_gap` = 紧邻上位者分数 − 自家（0 若自家第一；取"高于自家的最低分"，
+    ///   即排位直接压着自家的那家）。
+    /// - 行 5：`lead_gap` = 自家 − 紧邻下位者分数（0 若自家垫底；取"低于自家的最高分"）。
+    ///
+    /// 归一化到 [0,1]（与 obs 全局值域一致）：`clamp(±100_000) / 200_000 + 0.5`，
+    /// 0.5 = 零差距。注：牌局长度实测 6~11 局不等（提前结束/西入），故**不做**剩余局
+    /// 归一化；"每局需得分"留给 S6d 的 GRP 顺位后验。
+    fn encode_urgency(&mut self) {
+        let me = self.state.scores[0];
+        let mut all = self.state.scores;
+        all.sort_unstable_by(|a, b| b.cmp(a)); // 四家分数降序
+        let enc = |diff: i32| -> f32 { diff.clamp(-100_000, 100_000) as f32 / 200_000. + 0.5 };
+
+        for k in 0..4 {
+            self.arr.fill(self.idx + k, enc(me - all[k]));
+        }
+
+        // 紧邻上位：仍高于自家的玩家里的最低分；紧邻下位：仍低于自家的玩家里的最高分。
+        let above = all.iter().copied().filter(|&s| s > me).min();
+        let below = all.iter().copied().filter(|&s| s < me).max();
+        self.arr.fill(self.idx + 4, enc(above.map_or(0, |s| s - me)));
+        self.arr.fill(self.idx + 5, enc(me - below.unwrap_or(me)));
+        self.idx += 6;
+    }
